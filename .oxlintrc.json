{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "options": {
    "typeAware": true
  },
  "env": {
    "builtin": true,
    "es2026": true,
    "node": true
  },
  "ignorePatterns": ["**/node_modules/**", "dist/**"],
  "rules": {
    "import/no-unassigned-import": "off",
    "no-console": "error",
    "typescript/no-unsafe-type-assertion": "off"
  }
}
